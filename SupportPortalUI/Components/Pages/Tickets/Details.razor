@page "/tickets/{Id:int}"
@using SupportPortalUI.Models
@inject SupportPortalUI.ApiClients.Interfaces.ITicketsApiClient TicketsClient

<PageTitle>Ticket Details</PageTitle>

@if (isLoading)
{
    <Loading />
}
else if (!string.IsNullOrEmpty(error))
{
    <ErrorMessage Message="@error" />
}
else if (ticket is not null)
{
    <h3>@ticket.Name</h3>
    <dl class="row">
        <dt class="col-sm-3">Severity</dt>
        <dd class="col-sm-9">@ticket.Severity</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@ticket.Status</dd>
        <dt class="col-sm-3">Assigned To</dt>
        <dd class="col-sm-9">@ticket.AssignedTo</dd>
        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@ticket.CreatedDate.ToString("g")</dd>
        <dt class="col-sm-3">Escalation</dt>
        <dd class="col-sm-9">@((ticket.EscalationId is null) ? "None" : (MarkupString)$"<a href=\"/escalations/{ticket.EscalationId}\">Escalation {ticket.EscalationId}</a>")</dd>
    </dl>

    <div class="mb-3">
        <button class="btn btn-primary me-2" @onclick="OpenCreateEscalation">Create Escalation</button>
        <button class="btn btn-secondary" @onclick="() => showNotes = true">Show Notes</button>
    </div>

    <CreateEscalationModal IsOpen="showCreateEscalation" IsOpenChanged="@(b => showCreateEscalation = b)" SourceTicketId="@ticket.Id" OnCreated="OnEscalationCreated" />
    <NotesModal IsOpen="showNotes" IsOpenChanged="@(b => showNotes = b)" TicketId="@ticket.Id" />
}

@code {
    [Parameter]
    public Int64 Id { get; set; }

    private TicketDto? ticket;
    private bool isLoading = true;
    private string? error;

    private bool showCreateEscalation;
    private bool showNotes;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;
        try
        {
            ticket = await TicketsClient.GetByIdAsync(Id);
            if (ticket is null) error = "Ticket not found.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateEscalation()
    {
        showCreateEscalation = true;
    }

    private async Task OnEscalationCreated(Int64 escalationId)
    {
        if (ticket is null) return;
        ticket.EscalationId = escalationId;
        var ok = await TicketsClient.UpdateAsync(ticket.Id, ticket);
        if (!ok)
        {
            // surface error non-blocking
            error = "Failed to link ticket to escalation.";
        }
        await LoadAsync();
    }
}
