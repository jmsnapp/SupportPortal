@page "/tickets"
@using SupportPortalDomain.Models
@inject SupportPortalUI.ApiClients.Interfaces.ITicketsApiClient TicketsClient

<PageTitle>Tickets</PageTitle>

<h3>Open Tickets</h3>

@if (isLoading)
{
    <Loading />
}
else if (!string.IsNullOrEmpty(error))
{
    <ErrorMessage Message="@error" />
}
else
{
    <table class="table table-sm">
        <thead><tr><th>Id</th><th>Description</th><th>Severity</th><th>Status</th><th>Assigned</th><th>Created</th></tr></thead>
        <tbody>
            @foreach (var t in tickets)
            {
                <tr>
                    <td>@t.Id</td>
                    <td><NavLink class="nav-link p-0" href="@($"/tickets/{t.Id}")">@t.Description</NavLink></td>
                    <td>@t.Severity.Description</td>
                    <td>@t.Status.Description</td>
                    <td>@t.AssignedTo</td>
                    <td>@t.CreatedDate.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<Ticket> tickets = Array.Empty<Ticket>();
    private bool isLoading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tickets = await TicketsClient.GetActiveAsync(100);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
