@page "/admin/customers"
@using SupportPortalDomain.Models
@inject SupportPortalUI.ApiClients.Interfaces.ICustomersApiClient Clients

<PageTitle>Admin - Customers</PageTitle>

<h3>Customers</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="() => showCreate = true">Create Customer</button>
</div>

@if (isLoading)
{
    <Loading />
}
else if (!string.IsNullOrEmpty(error))
{
    <ErrorMessage Message="@error" />
}
else
{
    <table class="table table-sm">
        <thead><tr><th>Id</th><th>Name</th><th>Deleted</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in items)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Name</td>
                    <td>@c.Deleted</td>
                    <td>
                        <button class="btn btn-sm btn-secondary me-1" @onclick="() => Edit(c)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(c)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<CustomerEntityModal IsOpen="showCreate" IsOpenChanged="@(b => showCreate = b)" Title="Create Customer" Model="newModel" OnSaved="OnCreateSaved" />
<CustomerEntityModal IsOpen="showEdit" IsOpenChanged="@(b => showEdit = b)" Title="Edit Customer" Model="editModel" OnSaved="OnEditSaved" />
<ConfirmModal IsOpen="showConfirm" IsOpenChanged="@(b => showConfirm = b)" Title="Delete Customer" Message="Are you sure you want to mark this customer as deleted?" OnConfirmed="OnDeleteConfirmed" />

@code {
    private IEnumerable<Customer> items = Array.Empty<Customer>();
    private bool isLoading = true;
    private string? error;

    private bool showCreate;
    private bool showEdit;
    private Customer newModel = new();
    private Customer editModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;
        try
        {
            items = await Clients.GetAllAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally { isLoading = false; }
    }

    private void Edit(Customer dto)
    {
        editModel = new Customer { Id = dto.Id, Name = dto.Name, Deleted = dto.Deleted };
        showEdit = true;
    }

    private Customer? deletingModel;
    private bool showConfirm;

    private void ConfirmDelete(Customer dto)
    {
        deletingModel = dto;
        showConfirm = true;
    }

    private async Task OnDeleteConfirmed()
    {
        if (deletingModel is null) return;
        deletingModel.Deleted = true;
        var ok = await Clients.UpdateAsync(deletingModel.Id, deletingModel);
        if (ok) await LoadAsync();
        deletingModel = null;
    }

    private async Task OnCreateSaved(Customer dto)
    {
        var created = await Clients.CreateAsync(dto);
        if (created is not null) await LoadAsync();
    }

    private async Task OnEditSaved(Customer dto)
    {
        if (dto.Id == 0) return;
        var ok = await Clients.UpdateAsync(dto.Id, dto);
        if (ok) await LoadAsync();
    }
}
