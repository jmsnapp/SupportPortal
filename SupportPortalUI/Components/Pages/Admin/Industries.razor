@page "/admin/industries"
@using SupportPortalDomain.Models
@inject SupportPortalUI.ApiClients.Interfaces.IIndustriesApiClient Clients

<PageTitle>Admin - Industries</PageTitle>

<h3>Industries</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="() => showCreate = true">Create Industry</button>
</div>

@if (isLoading)
{
    <Loading />
}
else if (!string.IsNullOrEmpty(error))
{
    <ErrorMessage Message="@error" />
}
else
{
    <table class="table table-sm">
        <thead><tr><th>Id</th><th>Name</th><th>Deleted</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in items)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Name</td>
                    <td>@c.Deleted</td>
                    <td>
                        <button class="btn btn-sm btn-secondary me-1" @onclick="() => Edit(c)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(c)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<AdminEntityModal IsOpen="showCreate" IsOpenChanged="@(b => showCreate = b)" Title="Create Industry" Model="newModel" OnSaved="OnCreateSaved" />
<AdminEntityModal IsOpen="showEdit" IsOpenChanged="@(b => showEdit = b)" Title="Edit Industry" Model="editModel" OnSaved="OnEditSaved" />
<ConfirmModal IsOpen="showConfirm" IsOpenChanged="@(b => showConfirm = b)" Title="Delete Industry" Message="Are you sure you want to mark this industry as deleted?" OnConfirmed="OnDeleteConfirmed" />

@code {
    private IEnumerable<Industry> items = Array.Empty<Industry>();
    private bool isLoading = true;
    private string? error;

    private bool showCreate;
    private bool showEdit;
    private Industry newModel = new();
    private Industry editModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;
        try
        {
            items = await Clients.GetAllAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally { isLoading = false; }
    }

    private void Edit(Industry dto)
    {
        editModel = new Industry { Id = dto.Id, Name = dto.Name, Deleted = dto.Deleted };
        showEdit = true;
    }

    private Industry? deletingModel;
    private bool showConfirm;

    private void ConfirmDelete(Industry dto)
    {
        deletingModel = dto;
        showConfirm = true;
    }

    private async Task OnDeleteConfirmed()
    {
        if (deletingModel is null) return;
        deletingModel.Deleted = true;
        var ok = await Clients.UpdateAsync(deletingModel.Id, deletingModel);
        if (ok) await LoadAsync();
        deletingModel = null;
    }

    private async Task OnCreateSaved(PortalObject dto)
    {
        Industry industry = new Industry
        {
            Id = dto.Id,
            Name = dto.Name,
            Description = dto.Description,
            Deleted = dto.Deleted
        };

        var created = await Clients.CreateAsync(industry);
        if (created is not null) await LoadAsync();
    }

    private async Task OnEditSaved(PortalObject dto)
    {
        if (dto.Id == 0) return;

        Industry industry = new Industry
        {
            Id = dto.Id,
            Name = dto.Name,
            Description = dto.Description,
            Deleted = dto.Deleted
        };

        var ok = await Clients.UpdateAsync(dto.Id, industry);
        if (ok) await LoadAsync();
    }
}
