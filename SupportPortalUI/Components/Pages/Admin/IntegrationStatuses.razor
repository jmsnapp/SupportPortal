@page "/admin/integration-statuses"
@using SupportPortalDomain.Models
@inject SupportPortalUI.ApiClients.Interfaces.IIntegrationStatusesApiClient Clients

<PageTitle>Admin - Integration Statuses</PageTitle>

<h3>Integration Statuses</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="() => showCreate = true">Create Integration Status</button>
</div>

@if (isLoading)
{
    <Loading />
}
else if (!string.IsNullOrEmpty(error))
{
    <ErrorMessage Message="@error" />
}
else
{
    <table class="table table-sm">
        <thead><tr><th>Id</th><th>Name</th><th>Deleted</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in items)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Name</td>
                    <td>@c.Deleted</td>
                    <td>
                        <button class="btn btn-sm btn-secondary me-1" @onclick="() => Edit(c)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(c)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<AdminEntityModal IsOpen="showCreate" IsOpenChanged="@(b => showCreate = b)" Title="Create Integration Status" Model="newModel" OnSaved="OnCreateSaved" />
<AdminEntityModal IsOpen="showEdit" IsOpenChanged="@(b => showEdit = b)" Title="Edit Integration Status" Model="editModel" OnSaved="OnEditSaved" />
<ConfirmModal IsOpen="showConfirm" IsOpenChanged="@(b => showConfirm = b)" Title="Delete Integration Status" Message="Are you sure you want to mark this integration status as deleted?" OnConfirmed="OnDeleteConfirmed" />

@code {
    private IEnumerable<IntegrationStatus> items = Array.Empty<IntegrationStatus>();
    private bool isLoading = true;
    private string? error;

    private bool showCreate;
    private bool showEdit;
    private IntegrationStatus newModel = new();
    private IntegrationStatus editModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;
        try
        {
            items = await Clients.GetAllAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally { isLoading = false; }
    }

    private void Edit(IntegrationStatus dto)
    {
        editModel = new IntegrationStatus { Id = dto.Id, Name = dto.Name, Deleted = dto.Deleted };
        showEdit = true;
    }

    private IntegrationStatus? deletingModel;
    private bool showConfirm;

    private void ConfirmDelete(IntegrationStatus dto)
    {
        deletingModel = dto;
        showConfirm = true;
    }

    private async Task OnDeleteConfirmed()
    {
        if (deletingModel is null) return;
        deletingModel.Deleted = true;
        var ok = await Clients.CreateAsync(deletingModel);
        // Note: Integration statuses ApiClient CreateAsync exists; to soft-delete we need UpdateAsync.
        // Try UpdateAsync if available
        try
        {
            var updated = await Clients.UpdateAsync(deletingModel.Id, deletingModel);
            if (updated) await LoadAsync();
        }
        catch
        {
            // fallback: reload
            await LoadAsync();
        }
        deletingModel = null;
    }

    private async Task OnCreateSaved(PortalObject dto)
    {
        IntegrationStatus status = new IntegrationStatus
        {
            Id = dto.Id,
            Name = dto.Name,
            Description = dto.Description,
            Deleted = dto.Deleted
        };

        var created = await Clients.CreateAsync(status);
        if (created is not null) await LoadAsync();

    }

    private async Task OnEditSaved(PortalObject dto)
    {
        if (dto.Id == 0) return;

        IntegrationStatus status = new IntegrationStatus
        {
            Id = dto.Id,
            Name = dto.Name,
            Description = dto.Description,
            Deleted = dto.Deleted
        };

        var ok = await Clients.UpdateAsync(dto.Id, status);
        if (ok) await LoadAsync();
    }
}
