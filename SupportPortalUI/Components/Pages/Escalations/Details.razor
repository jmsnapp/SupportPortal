@page "/escalations/{Id:int}"
@using SupportPortalUI.Models
@inject SupportPortalUI.ApiClients.Interfaces.IEscalationsApiClient EscalationsClient
@inject SupportPortalUI.ApiClients.Interfaces.ITicketsApiClient TicketsClient

<PageTitle>Escalation Details</PageTitle>

@if (isLoading)
{
    <Loading />
}
else if (!string.IsNullOrEmpty(error))
{
    <ErrorMessage Message="@error" />
}
else if (escalation is not null)
{
    <h3>@escalation.Name</h3>
    <p>@escalation.ProblemSummary</p>
    <p><strong>Created:</strong> @escalation.CreatedDate.ToString("g")</p>

    <h5>Linked Tickets</h5>
    @if (linkedLoading)
    {
        <Loading />
    }
    else if (!string.IsNullOrEmpty(linkedError))
    {
        <ErrorMessage Message="@linkedError" />
    }
    else
    {
        <ul class="list-group">
            @foreach (var t in linkedTickets)
            {
                <li class="list-group-item"><a href="/tickets/@t.Id">@t.Name</a> <small class="text-muted">@t.Status</small></li>
            }
        </ul>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EscalationDto? escalation;
    private bool isLoading = true;
    private string? error;

    private IEnumerable<TicketDto> linkedTickets = Array.Empty<TicketDto>();
    private bool linkedLoading;
    private string? linkedError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;
        try
        {
            escalation = await EscalationsClient.GetByIdAsync(Id);
            if (escalation is null) error = "Escalation not found.";
            else await LoadLinkedTicketsAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLinkedTicketsAsync()
    {
        linkedLoading = true;
        linkedError = null;
        try
        {
            var all = await TicketsClient.GetActiveAsync(100);
            linkedTickets = all.Where(t => t.EscalationId == Id);
        }
        catch (Exception ex)
        {
            linkedError = ex.Message;
        }
        finally
        {
            linkedLoading = false;
        }
    }
}
