@page "/projects"
@using SupportPortalDomain.Models
@inject SupportPortalUI.ApiClients.Interfaces.IProjectsApiClient ProjectsClient

<PageTitle>Projects</PageTitle>

<h3>Open Projects</h3>

@if (isLoading)
{
    <Loading />
}
else if (!string.IsNullOrEmpty(error))
{
    <ErrorMessage Message="@error" />
}
else
{
    <table class="table table-sm">
        <thead><tr><th>Id</th><th>Description</th><th>Phase</th><th>Target Go Live</th></tr></thead>
        <tbody>
            @foreach (var p in projects)
            {
                <tr>
                    <td>@p.Id</td>
                    <td><NavLink class="nav-link p-0" href="@($"/projects/{p.Id}")">@p.Description</NavLink></td>
                    <td>@p.CurrentPhase.Description</td>
                    <td>@(p.TargetGoLive.ToString("d") ?? string.Empty)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<Project> projects = Array.Empty<Project>();
    private bool isLoading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            projects = await ProjectsClient.GetActiveAsync(100);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally { isLoading = false; }
    }
}
